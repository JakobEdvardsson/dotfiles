#!/bin/bash
# Publish the generated Slack theme for the running Slack launcher.
#
# Local backport of omarchy#17113. The launcher watches theme.json and retints
# open Slack windows when it is replaced.

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/slack"
theme="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/slack.json"

# Leave machines that never enabled Slack theming alone.
[[ -f $state_dir/enabled && -f $theme ]] || exit 0

pending=$(mktemp "$state_dir/theme.XXXXXX")
trap 'rm -f "$pending"' EXIT
if jq -e 'select(.mode == "light" or .mode == "dark") |
  select([.background, .accent, .green, .red] | all(type == "string" and test("^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"))) |
  {mode, background, accent, green, red} |
  with_entries(if .key == "mode" then . else .value |= .[0:7] end)' "$theme" >"$pending"; then
  mv "$pending" "$state_dir/theme.json"
else
  echo "Skipping invalid Slack theme." >&2
fi
