#!/bin/bash
# Regenerate OpenCode's "omarchy" theme from the active Omarchy palette.

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current"
colors="$state_dir/theme/colors.toml"
config_dir="${OPENCODE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"
theme_file="$config_dir/themes/omarchy.json"

if [[ ! -f $colors ]]; then
  echo "omarchy-opencode-theme: no active palette at $colors" >&2
  exit 1
fi

mkdir -p "$config_dir/themes"
tmp=$(mktemp "$theme_file.XXXXXX")
trap 'rm -f "$tmp"' EXIT

python3 - "$colors" >"$tmp" <<'PY'
import json
import re
import sys

palette = {}
for line in open(sys.argv[1], encoding="utf-8"):
    match = re.match(r'^\s*([A-Za-z0-9_]+)\s*=\s*"([^"]+)"', line)
    if match:
        palette[match.group(1)] = match.group(2)

# Older themes describe their palette as ANSI slots instead of named colours.
# Alias those slots onto the semantic names so both formats work.
ansi_aliases = {
    "black": "color0",
    "red": "color1",
    "green": "color2",
    "yellow": "color3",
    "blue": "color4",
    "magenta": "color5",
    "cyan": "color6",
    "white": "color7",
    "bright_black": "color8",
    "bright_red": "color9",
    "bright_green": "color10",
    "bright_yellow": "color11",
    "bright_blue": "color12",
    "bright_magenta": "color13",
    "bright_cyan": "color14",
    "bright_white": "color15",
}
for name, slot in ansi_aliases.items():
    if name not in palette and slot in palette:
        palette[name] = palette[slot]

# Fill in semantic shades the palette format does not always carry.
shade_fallbacks = {
    "accent": ("blue", "color4"),
    "dark_background": ("background",),
    "darker_background": ("dark_background", "background"),
    "lighter_background": ("background",),
    "muted": ("color8", "bright_black", "white", "foreground"),
    "orange": ("yellow", "color3"),
    "bright_foreground": ("foreground",),
}
for name, fallbacks in shade_fallbacks.items():
    if name in palette:
        continue
    for fallback in fallbacks:
        if fallback in palette:
            palette[name] = palette[fallback]
            break

def color(name, fallback=None):
    return palette.get(name) or (palette.get(fallback) if fallback else None) or palette[name]

def mix(base, tint, percent):
    weight = percent / 100
    channels = []
    for index in (1, 3, 5):
        under = int(base[index:index + 2], 16)
        over = int(tint[index:index + 2], 16)
        channels.append(round(under * (1 - weight) + over * weight))
    return "#" + "".join(f"{value:02x}" for value in channels)

background = color("background")
foreground = color("foreground")
accent = color("accent")
muted = color("muted", "color8")
red = color("red")
yellow = color("yellow")
green = color("green")
cyan = color("cyan")
blue = color("blue")
magenta = color("magenta")
orange = color("orange", "yellow")
bright_foreground = color("bright_foreground", "foreground")
bright_red = color("bright_red", "red")
bright_green = color("bright_green", "green")

theme = {
    "$schema": "https://opencode.ai/theme.json",
    "theme": {
        "primary": accent,
        "secondary": cyan,
        "accent": accent,
        "error": red,
        "warning": yellow,
        "success": green,
        "info": blue,
        "text": foreground,
        "textMuted": muted,
        "selectedListItemText": foreground,
        "background": background,
        "backgroundPanel": color("dark_background", "background"),
        "backgroundElement": color("darker_background", "dark_background"),
        "backgroundMenu": mix(background, foreground, 6),
        "border": mix(background, foreground, 18),
        "borderActive": muted,
        "borderSubtle": mix(background, foreground, 12),
        "diffAdded": green,
        "diffRemoved": red,
        "diffContext": muted,
        "diffHunkHeader": muted,
        "diffHighlightAdded": bright_green,
        "diffHighlightRemoved": bright_red,
        "diffAddedBg": mix(background, green, 14),
        "diffRemovedBg": mix(background, red, 14),
        "diffContextBg": background,
        "diffLineNumber": mix(background, foreground, 25),
        "diffAddedLineNumberBg": mix(background, green, 8),
        "diffRemovedLineNumberBg": mix(background, red, 8),
        "markdownText": foreground,
        "markdownHeading": bright_foreground,
        "markdownLink": blue,
        "markdownLinkText": cyan,
        "markdownCode": cyan,
        "markdownBlockQuote": muted,
        "markdownEmph": yellow,
        "markdownStrong": bright_foreground,
        "markdownHorizontalRule": mix(background, foreground, 20),
        "markdownListItem": accent,
        "markdownListEnumeration": cyan,
        "markdownImage": blue,
        "markdownImageText": cyan,
        "markdownCodeBlock": foreground,
        "syntaxComment": muted,
        "syntaxKeyword": magenta,
        "syntaxFunction": blue,
        "syntaxVariable": foreground,
        "syntaxString": green,
        "syntaxNumber": orange,
        "syntaxType": yellow,
        "syntaxOperator": cyan,
        "syntaxPunctuation": muted,
        "thinkingOpacity": 0.6,
    },
}

json.dump(theme, sys.stdout, indent=2)
sys.stdout.write("\n")
PY

mv "$tmp" "$theme_file"
trap - EXIT
