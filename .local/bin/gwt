#!/usr/bin/env bash
#
# gwt - create a git worktree (or seed an existing one) with the local files
# git does not carry, so you don't have to rebuild everything (node_modules,
# venvs, caches, devenv.local, ...).
#
# Copies every untracked file (ignored AND non-ignored) from the source repo
# into the destination, but never .git metadata or anything tracked on the
# destination's branch, so the tracked content always matches the branch.
#
# On btrfs/xfs the copy is reflinked, so it is fast and shares extents until
# a file is modified.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: gwt [--from <ref>] [-n|--dry-run] <branch> [<dest>]
       gwt seed <src> <dest>
       gwt --print-dest <branch> [<dest>]

Create a git worktree for <branch> and copy your local (ignored/untracked)
files from the current repo into it, so you don't rebuild everything.

  --from <ref>      base the new branch on <ref> (default: current HEAD)
  -n, --dry-run     print what would be copied without creating anything
  --print-dest      print the destination path and exit (for wrappers)
  <branch>          new branch name (worktree is created with -b <branch>)
  <dest>            destination dir (default: sibling of the repo root, named
                    <repo>-<branch>)

  seed <src> <dest> copy untracked/ignored local files from <src> into the
                    existing worktree <dest>. Used by the Herdr worktree
                    bootstrap hook.

Only untracked files are copied (ignored caches/build outputs AND plain
untracked files like devenv.local). All .git metadata is left alone, and any
path tracked on the destination branch is skipped, so its tracked content
always matches the branch.

Common disposable trees are skipped (tmp/, __pycache__/, .ruff_cache/,
.pytest_cache/, .mypy_cache/, .terraform-*/, coverage/). Set GWT_EXCLUDES to
an extra extended-regexp fragment to skip more.

If <branch> is already checked out in another worktree, gwt reuses that
worktree instead of creating a duplicate and detaching the existing one.

examples
--------
  # spin up a worktree for a new branch, default sibling dir:
  #   ~/code/neo4j-cloud-fix-billing  (keeps devenv.local, venv, node_modules)
  gwt fix-billing

  # base the new branch on 'main' instead of the current HEAD:
  gwt --from main fix-billing

  # branch with slashes -> the default dir uses '-' (fix/foo -> repo-fix-foo)
  gwt fix/foo

  # reuse an existing branch. if it is already checked out in a worktree,
  # gwt points you at that worktree instead of creating a duplicate:
  gwt existing-branch

  # choose the destination explicitly:
  gwt fix-billing ~/code/wt/fix-billing

  # see what would be copied without creating anything:
  gwt -n fix-billing

  # seed an already-created worktree (Herdr bootstrap does this):
  gwt seed ~/code/neo4j-cloud ~/code/worktrees/neo4j-cloud/fix-billing

  # check the result:
  git worktree list
EOF
}

die() { echo "gwt: $*" >&2; exit 1; }

supports_reflink() {
  cp --help 2>/dev/null | grep -q -- '--reflink'
}

# Skip disposable local trees that are expensive and useless in a fresh checkout.
exclude_re='(^|/)tmp/|(^|/)__pycache__/|\.pyc$|(^|/)\.ruff_cache/|(^|/)\.pytest_cache/|(^|/)\.mypy_cache/|(^|/)\.terraform-[^/]+/|(^|/)coverage/|(^|/)\.coverage$'
if [[ -n "${GWT_EXCLUDES:-}" ]]; then
  exclude_re="${exclude_re}|${GWT_EXCLUDES}"
fi

# Build the NUL-separated list of local files to copy from <src> into a
# checkout whose tracked files are listed in <tracked>.
# Sets COPY_LIST (temp file).
build_copy_list() {
  local src="$1" tracked="$2"
  local raw filtered
  raw="$(mktemp)"
  filtered="$(mktemp)"

  {
    git -C "$src" ls-files -z --others --exclude-standard
    git -C "$src" ls-files -z --others --ignored --exclude-standard
  } | grep -zv '^\.git/' | LC_ALL=C sort -zu > "$raw" || true

  # Never copy a path that is tracked on the destination branch: it would
  # clobber the checkout's tracked content.
  LC_ALL=C comm -z -23 "$raw" "$tracked" | grep -zvE "$exclude_re" > "$filtered" || true

  rm -f "$raw"
  COPY_LIST="$filtered"
}

# copy_local_files <src> <dest> <list>
copy_local_files() {
  local src="$1" dest="$2" list="$3"
  local count
  count="$(tr -cd '\0' < "$list" | wc -c)"

  if [[ "$count" -eq 0 ]]; then
    return 0
  fi

  echo "gwt: copying $count local file(s)..."

  if supports_reflink; then
    # --parents recreates the relative tree; --reflink=auto falls back to a
    # normal copy on filesystems that do not support reflinks.
    ( cd "$src" && xargs -0 -r -n 500 cp -a --reflink=auto --parents --target-directory="$dest" -- < "$list" )
  else
    if [[ -t 1 ]]; then
      ( cd "$src" && rsync -a --info=progress2 --files-from="$list" --from0 ./ "$dest/" )
    else
      ( cd "$src" && rsync -a --files-from="$list" --from0 ./ "$dest/" )
    fi
  fi
}

# --- seed subcommand --------------------------------------------------------
# Copies local state into an existing checkout. Used by the Herdr
# worktree.created hook.
if [[ "${1:-}" == "seed" ]]; then
  shift
  src="${1:-}"
  dest="${2:-}"
  [[ -n "$src" && -n "$dest" ]] || { echo "usage: gwt seed <src> <dest>" >&2; exit 1; }

  src="$(git -C "$src" rev-parse --show-toplevel 2>/dev/null)" \
    || die "not a git checkout: $src"
  [[ -d "$dest" ]] || die "destination does not exist: $dest"
  git -C "$dest" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "destination is not a git checkout: $dest"
  [[ "$(realpath "$src")" != "$(realpath "$dest")" ]] \
    || die "source and destination are the same checkout: $dest"

  tracked="$(mktemp)"
  COPY_LIST=""
  trap 'rm -f "$tracked" "$COPY_LIST"' EXIT
  git -C "$dest" ls-tree -r -z --name-only HEAD | LC_ALL=C sort -zu > "$tracked"

  build_copy_list "$src" "$tracked"
  copy_local_files "$src" "$dest" "$COPY_LIST"
  echo "gwt: seeded -> $dest"
  exit 0
fi

# --- worktree creation ------------------------------------------------------
repo_top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repo"
repo_name="$(basename "$repo_top")"

# Print the worktree path where <branch> is currently checked out, if any.
worktree_for_branch() {
  git -C "$repo_top" worktree list --porcelain | awk -v want="refs/heads/$1" '
    /^worktree / { path = substr($0, 10) }
    $0 == "branch " want { print path; exit }
  '
}

from="HEAD"
dest=""
dry_run=0
print_dest=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --from) from="${2:-}"; shift 2 ;;
    -n|--dry-run) dry_run=1; shift ;;
    --print-dest) print_dest=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "gwt: unknown option: $1" >&2; usage; exit 1 ;;
    *) break ;;
  esac
done

branch="${1:-}"
[[ -n "$branch" ]] || { usage; exit 1; }

if [[ -n "${2:-}" ]]; then
  dest="$2"
else
  safe="$(printf '%s' "$branch" | tr '/' '-')"
  dest="${repo_top%/*}/${repo_name}-${safe}"
fi

holder="$(worktree_for_branch "$branch")"

if [[ "$print_dest" -eq 1 ]]; then
  if [[ -n "$holder" ]]; then
    printf '%s\n' "$holder"
  else
    printf '%s\n' "$dest"
  fi
  exit 0
fi

# If the branch is already checked out somewhere, reuse that worktree rather
# than creating a duplicate and detaching the existing one. The exception is
# when it is already at our destination, handled as a resume below so an
# interrupted copy can finish.
if [[ -n "$holder" ]]; then
  holder_real="$(realpath "$holder")"
  dest_real=""
  [[ -e "$dest" ]] && dest_real="$(realpath "$dest")"
  if [[ "$holder_real" != "$dest_real" ]]; then
    echo "gwt: '$branch' is already checked out at $holder; reusing"
    echo "gwt: done -> $holder"
    exit 0
  fi
fi

# An existing non-empty destination is only ok if it is already a worktree
# of this repo on <branch> - then setup is skipped and the copy resumes.
resume=0
if [[ -e "$dest" ]]; then
  wt_branch="$(git -C "$repo_top" worktree list --porcelain | awk -v want="$(realpath "$dest")" '
    /^worktree / { wt = substr($0, 10) }
    wt == want && /^branch / { print substr($0, 8); exit }
    wt == want && /^detached/ { print "DETACHED"; exit }
  ')"
  if [[ -n "$wt_branch" && "$wt_branch" != "refs/heads/$branch" ]]; then
    die "'$dest' is already a worktree on '${wt_branch#refs/heads/}'; refusing."
  fi
  if [[ -z "$wt_branch" && -n "$(ls -A "$dest" 2>/dev/null)" ]]; then
    die "destination '$dest' exists and is not empty; refusing.\n     pass a nonexistent or empty path."
  fi
  [[ -n "$wt_branch" ]] && resume=1
fi

tracked="$(mktemp)"
COPY_LIST=""
trap 'rm -f "$tracked" "$COPY_LIST"' EXIT

# A path untracked in the source may still be tracked on the target ref (the
# existing branch, or the base of a new one). Never copy those.
if git -C "$repo_top" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
  target_ref="refs/heads/$branch"
else
  target_ref="$from"
fi
git -C "$repo_top" ls-tree -r -z --name-only "$target_ref" | LC_ALL=C sort -zu > "$tracked"
build_copy_list "$repo_top" "$tracked"

if [[ "$dry_run" -eq 1 ]]; then
  echo "gwt: branch : $branch (from $from)"
  echo "gwt: dest   : $dest"
  echo "gwt: would copy $(tr -cd '\0' < "$COPY_LIST" | wc -c) file(s):"
  tr '\0' '\n' < "$COPY_LIST"
  exit 0
fi

if [[ "$resume" -eq 1 ]]; then
  echo "gwt: '$branch' is already checked out at $dest; resuming"
elif git -C "$repo_top" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
  echo "gwt: attaching existing branch '$branch' at $dest"
  git -C "$repo_top" worktree add "$dest" "$branch"
else
  echo "gwt: creating worktree '$branch' at $dest (from $from)"
  git -C "$repo_top" worktree add -b "$branch" "$dest" "$from"
fi

copy_local_files "$repo_top" "$dest" "$COPY_LIST"

echo "gwt: done -> $dest"
