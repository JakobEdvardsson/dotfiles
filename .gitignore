# Runtime state and secrets that must never be tracked
.config/opencode/service.json
.config/opencode/*.log
.config/herdr/*.log
.config/herdr/session.json
.config/herdr/.plugins.lock
.nvimlog

# Backup files (timestamped .bak copies made before editing configs)
*.bak
*.bak.*

# OmaControl runtime state (read news, cached monitor settings)
.config/omarchy/omacontrol.json

# Runtime locks (dictation backend selection)
.config/omarchy/defaults/dictation.lock
