;; kanata: laptop keyboard -> Colemak-DH over the Swedish layout.
;; KDE stays plain Swedish; kanata remaps letters, plus:
;;   Caps Lock        -> Backspace
;;   hold Space       -> HJKL become arrow keys (tap Space = space)
;;   home-row mods:   a=GUI r=ALT s=CTRL t=SHIFT | n=SHIFT e=CTRL i=ALT o=GUI
;; Everything else (å ä ö, numbers, punctuation, modifiers) passes through.

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  chords-v2-min-idle 150
  linux-dev-names-include ("AT Translated Set 2 keyboard")
)

;; combo: hold J+K (letters n+e) together = Backspace, like your
;; Moonlander's N+E = Del combo. Activates only when both are held
;; within 150ms; otherwise the letters type normally.
(defchordsv2
  (j k) bspc 100 first-release (nav)
)

(defsrc)

(deflayermap (base)
  caps bspc
  spc  (tap-hold 200 300 spc (layer-while-held nav))

  ;; top row: q w f p b | j l u y ö
  e f
  r p
  t b
  y j
  u l
  i u
  o y
  p scln

  ;; home row: a r s t g | m n e i o  (tap letter / hold modifier)
  a (tap-hold 250 250 a lmet)
  s (tap-hold 250 250 r lalt)
  d (tap-hold 250 250 s lctl)
  f (tap-hold 250 250 t lsft)
  h m
  j (tap-hold 250 250 n lsft)
  k (tap-hold 250 250 e lctl)
  l (tap-hold 250 250 i lalt)
  scln (tap-hold 250 250 o lmet)   ;; physical ö key: tap = o, hold = GUI

  ;; bottom row: z x c d v k h
  v d
  b v
  n k
  m h
)

(deflayermap (nav)
  j left
  k down
  l up
  scln right
)
