;; kanata: laptop keyboard, KDE layout stays plain Swedish (se).
;;
;; DEFAULT = QWERTY passthrough (plain Swedish).
;; Tap the §/½ key (top-left) to toggle between:
;;   qwerty  — plain Swedish, pure passthrough
;;   colemak — Colemak-DH letters + home-row mods + Caps=Backspace
;;             + hold Space = HJKL arrows
;; A notification tells you which mode you're in.
;; Emergency: this binary is the cmd-allowed build; Meta+Q also
;; stops the whole service (KDE shortcut, if bound).

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  chords-v2-min-idle 150
  linux-dev-names-include ("AT Translated Set 2 keyboard")
  danger-enable-cmd yes
)

(defalias
  cm-on  (multi (layer-switch colemak) (cmd /home/jakobe/.local/bin/kanata-notify "Colemak-DH" "home-row mods + space-nav active"))
  cm-off (multi (layer-switch qwerty)  (cmd /home/jakobe/.local/bin/kanata-notify "QWERTY" "plain Swedish keyboard"))
)

(defsrc)

(deflayermap (qwerty)
  grv @cm-on
)

(deflayermap (colemak)
  grv @cm-off

  caps (tap-hold 200 300 bspc (layer-while-held nav))

  ;; top row: q w f p b | j l u y ö
  e f
  r p
  t b
  y j
  u l
  i u
  o y
  p scln

  ;; home row: a r s t g | m n e i o (tap letter / hold modifier)
  a (tap-hold 250 250 a lmet)
  s (tap-hold 250 250 r lalt)
  d (tap-hold 250 250 s lctl)
  f (tap-hold 250 250 t lsft)
  h m
  j (tap-hold 250 250 n lsft)
  k (tap-hold 250 250 e lctl)
  l (tap-hold 250 250 i lalt)
  scln (tap-hold 250 250 o lmet)   ;; physical ö key: tap = o, hold = GUI

  ;; bottom row: z x c d v k h
  v d
  b v
  n k
  m h
)

(deflayermap (nav)
  j left
  k down
  l up
  scln right
)

;; n+e (hold J+K) = Backspace, s+t (hold D+F) = Tab — Moonlander combos.
;; Disabled in qwerty (letters differ there) and nav layers.
(defchordsv2
  (j k) bspc 100 first-release (qwerty nav)
  (d f) tab  100 first-release (qwerty nav)
)
