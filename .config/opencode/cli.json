{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "plugins": ["./herdr-opencode"],
  "keybinds": {
    "session.first": "ctrl+g,alt+home",
    "session.last": "ctrl+alt+g",
    "input.line.home": "home,ctrl+a",
    "input.line.end": "end,ctrl+e",
    "input.buffer.home": "none",
    "input.buffer.end": "none"
  },
  "session": {
    "permissions": "autoaccept"
  }
}
