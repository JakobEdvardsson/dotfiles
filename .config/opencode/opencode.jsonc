{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "fireworks-ai/accounts/fireworks/models/deepseek-v4p1-flash-1017",
  "agents": {
    "build": {
      "model": "fireworks-ai/accounts/fireworks/models/deepseek-v4p1-flash-1017",
    },
    "plan": {
      "model": "fireworks-ai/accounts/fireworks/models/deepseek-v4p1-flash-1017",
    },
    "general": {
      "model": "fireworks-ai/accounts/fireworks/models/deepseek-v4p1-flash-1017",
    },
    "explore": {
      "model": "fireworks-ai/accounts/fireworks/models/deepseek-v4p1-flash-1017",
    },
    "teach": {
      "model": "fireworks-ai/accounts/fireworks/models/deepseek-v4p1-flash-1017",
    },
  },
  "permission": {
    "*": "allow",
    "external_directory": {
      "~/code/**": "allow",
      "~/dotfiles/**": "allow",
      "/tmp/**": "allow",
    },
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false,
    },
    "incidentio": {
      "type": "remote",
      "url": "https://mcp.incident.io/mcp",
      "enabled": false,
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
      },
    },
    "aura-portal": {
      "type": "remote",
      "url": "https://aura-portal.neo4j.io/api/mcp-actions/v1",
      "enabled": false,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
  },
}
