{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "incidentio_*": "deny",
    "linear_*": "deny",
    "*": "allow",
    "external_directory": {
      "~/code/**": "allow",
      "~/dotfiles/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "incidentio": {
      "type": "remote",
      "url": "https://mcp.incident.io/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "aura-portal": {
      "type": "remote",
      "url": "https://aura-portal.neo4j.io/api/mcp-actions/v1",
      "enabled": true
    }
  }
}
